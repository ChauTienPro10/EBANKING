                  "key": "size",
                  "value": "20"
                }
              ]
            }
          }
        }
        {
          "name": "Approve Transaction Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transaction-requests/1/approve?adminUsername=admin",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transaction-requests", "1", "approve"],
              "query": [
                {
                  "key": "adminUsername",
                  "value": "admin"
                }
