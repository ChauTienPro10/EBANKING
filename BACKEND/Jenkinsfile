pipeline {
    agent any
    
    environment {
        DOCKER_REGISTRY = 'your-registry.com'
        DOCKER_REPO = 'ebanking'
        MAVEN_OPTS = '-Xmx1024m'
        JAVA_HOME = '/usr/lib/jvm/java-17-openjdk'
    }
    
    tools {
        maven 'Maven-3.9.0'
        jdk 'JDK-17'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.BUILD_VERSION = sh(
                        script: "echo '1.0.${BUILD_NUMBER}'",
                        returnStdout: true
                    ).trim()
                }
            }
        }
        
        stage('Build & Test') {
            parallel {
                stage('Admin Tool') {
                    steps {
                        dir('adminTool') {
                            sh 'mvn clean compile test'
                        }
                    }
                    post {
                        always {
                            publishTestResults testResultsPattern: 'adminTool/target/surefire-reports/*.xml'
                        }
                    }
                }
                
                stage('Auth Service') {
                    steps {
                        dir('authService') {
                            sh 'mvn clean compile test'
                        }
                    }
                    post {
                        always {
                            publishTestResults testResultsPattern: 'authService/target/surefire-reports/*.xml'
                        }
                    }
                }
                
                stage('Chat Service') {
                    steps {
                        dir('chatService') {
                            sh 'mvn clean compile test'
                        }
                    }
                    post {
                        always {
                            publishTestResults testResultsPattern: 'chatService/target/surefire-reports/*.xml'
                        }
                    }
                }
                
                stage('Chatbot Service') {
                    steps {
                        dir('chatbotService') {
                            sh 'mvn clean compile test'
                        }
                    }
                    post {
                        always {
                            publishTestResults testResultsPattern: 'chatbotService/target/surefire-reports/*.xml'
                        }
                    }
                }
                
                stage('eKYC Service') {
                    steps {
                        dir('ekycService') {
                            sh 'mvn clean compile test'
                        }
                    }
                    post {
                        always {
                            publishTestResults testResultsPattern: 'ekycService/target/surefire-reports/*.xml'
                        }
                    }
                }
                
                stage('Email Service') {
                    steps {
                        dir('emailService') {
                            sh 'mvn clean compile test'
                        }
                    }
                    post {
                        always {
                            publishTestResults testResultsPattern: 'emailService/target/surefire-reports/*.xml'
                        }
                    }
                }
                
                stage('Firebase Service') {
                    steps {
                        dir('firebaseService') {
                            sh 'mvn clean compile test'
                        }
                    }
                    post {
                        always {
                            publishTestResults testResultsPattern: 'firebaseService/target/surefire-reports/*.xml'
                        }
                    }
                }
                
                stage('Transaction Service') {
                    steps {
                        dir('transactionService') {
                            sh 'mvn clean compile test'
                        }
                    }
                    post {
                        always {
                            publishTestResults testResultsPattern: 'transactionService/target/surefire-reports/*.xml'
                        }
                    }
                }
                
                stage('User Service') {
                    steps {
                        dir('userService') {
                            sh 'mvn clean compile test'
                        }
                    }
                    post {
                        always {
                            publishTestResults testResultsPattern: 'userService/target/surefire-reports/*.xml'
                        }
                    }
                }
                
                stage('Socket Service') {
                    steps {
                        dir('socket') {
                            sh 'mvn clean compile test'
                        }
                    }
                    post {
                        always {
                            publishTestResults testResultsPattern: 'socket/target/surefire-reports/*.xml'
                        }
                    }
                }
            }
        }
        
        stage('Package') {
            parallel {
                stage('Package Admin Tool') {
                    steps {
                        dir('adminTool') {
                            sh 'mvn package -DskipTests'
                            archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                        }
                    }
                }
                
                stage('Package Auth Service') {
                    steps {
                        dir('authService') {
                            sh 'mvn package -DskipTests'
                            archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                        }
                    }
                }
                
                stage('Package Chat Service') {
                    steps {
                        dir('chatService') {
                            sh 'mvn package -DskipTests'
                            archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                        }
                    }
                }
                
                stage('Package Chatbot Service') {
                    steps {
                        dir('chatbotService') {
                            sh 'mvn package -DskipTests'
                            archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                        }
                    }
                }
                
                stage('Package eKYC Service') {
                    steps {
                        dir('ekycService') {
                            sh 'mvn package -DskipTests'
                            archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                        }
                    }
                }
                
                stage('Package Email Service') {
                    steps {
                        dir('emailService') {
                            sh 'mvn package -DskipTests'
                            archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                        }
                    }
                }
                
                stage('Package Firebase Service') {
                    steps {
                        dir('firebaseService') {
                            sh 'mvn package -DskipTests'
                            archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                        }
                    }
                }
                
                stage('Package Transaction Service') {
                    steps {
                        dir('transactionService') {
                            sh 'mvn package -DskipTests'
                            archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                        }
                    }
                }
                
                stage('Package User Service') {
                    steps {
                        dir('userService') {
                            sh 'mvn package -DskipTests'
                            archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                        }
                    }
                }
                
                stage('Package Socket Service') {
                    steps {
                        dir('socket') {
                            sh 'mvn package -DskipTests'
                            archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                        }
                    }
                }
            }
        }
        
        stage('Docker Build & Push') {
            when {
                anyOf {
                    branch 'main'
                    branch 'develop'
                }
            }
            parallel {
                stage('Build Admin Tool Image') {
                    steps {
                        dir('adminTool') {
                            script {
                                def image = docker.build("${DOCKER_REGISTRY}/${DOCKER_REPO}/admin-tool:${BUILD_VERSION}")
                                docker.withRegistry("https://${DOCKER_REGISTRY}", 'docker-registry-credentials') {
                                    image.push()
                                    image.push('latest')
                                }
                            }
                        }
                    }
                }
                
                stage('Build Auth Service Image') {
                    steps {
                        dir('authService') {
                            script {
                                def image = docker.build("${DOCKER_REGISTRY}/${DOCKER_REPO}/auth-service:${BUILD_VERSION}")
                                docker.withRegistry("https://${DOCKER_REGISTRY}", 'docker-registry-credentials') {
                                    image.push()
                                    image.push('latest')
                                }
                            }
                        }
                    }
                }
                
                stage('Build Chat Service Image') {
                    steps {
                        dir('chatService') {
                            script {
                                def image = docker.build("${DOCKER_REGISTRY}/${DOCKER_REPO}/chat-service:${BUILD_VERSION}")
                                docker.withRegistry("https://${DOCKER_REGISTRY}", 'docker-registry-credentials') {
                                    image.push()
                                    image.push('latest')
                                }
                            }
                        }
                    }
                }
                
                stage('Build Chatbot Service Image') {
                    steps {
                        dir('chatbotService') {
                            script {
                                def image = docker.build("${DOCKER_REGISTRY}/${DOCKER_REPO}/chatbot-service:${BUILD_VERSION}")
                                docker.withRegistry("https://${DOCKER_REGISTRY}", 'docker-registry-credentials') {
                                    image.push()
                                    image.push('latest')
                                }
                            }
                        }
                    }
                }
                
                stage('Build eKYC Service Image') {
                    steps {
                        dir('ekycService') {
                            script {
                                def image = docker.build("${DOCKER_REGISTRY}/${DOCKER_REPO}/ekyc-service:${BUILD_VERSION}")
                                docker.withRegistry("https://${DOCKER_REGISTRY}", 'docker-registry-credentials') {
                                    image.push()
                                    image.push('latest')
                                }
                            }
                        }
                    }
                }
                
                stage('Build Email Service Image') {
                    steps {
                        dir('emailService') {
                            script {
                                def image = docker.build("${DOCKER_REGISTRY}/${DOCKER_REPO}/email-service:${BUILD_VERSION}")
                                docker.withRegistry("https://${DOCKER_REGISTRY}", 'docker-registry-credentials') {
                                    image.push()
                                    image.push('latest')
                                }
                            }
                        }
                    }
                }
                
                stage('Build Firebase Service Image') {
                    steps {
                        dir('firebaseService') {
                            script {
                                def image = docker.build("${DOCKER_REGISTRY}/${DOCKER_REPO}/firebase-service:${BUILD_VERSION}")
                                docker.withRegistry("https://${DOCKER_REGISTRY}", 'docker-registry-credentials') {
                                    image.push()
                                    image.push('latest')
                                }
                            }
                        }
                    }
                }
                
                stage('Build Transaction Service Image') {
                    steps {
                        dir('transactionService') {
                            script {
                                def image = docker.build("${DOCKER_REGISTRY}/${DOCKER_REPO}/transaction-service:${BUILD_VERSION}")
                                docker.withRegistry("https://${DOCKER_REGISTRY}", 'docker-registry-credentials') {
                                    image.push()
                                    image.push('latest')
                                }
                            }
                        }
                    }
                }
                
                stage('Build User Service Image') {
                    steps {
                        dir('userService') {
                            script {
                                def image = docker.build("${DOCKER_REGISTRY}/${DOCKER_REPO}/user-service:${BUILD_VERSION}")
                                docker.withRegistry("https://${DOCKER_REGISTRY}", 'docker-registry-credentials') {
                                    image.push()
                                    image.push('latest')
                                }
                            }
                        }
                    }
                }
                
                stage('Build Socket Service Image') {
                    steps {
                        dir('socket') {
                            script {
                                def image = docker.build("${DOCKER_REGISTRY}/${DOCKER_REPO}/socket-service:${BUILD_VERSION}")
                                docker.withRegistry("https://${DOCKER_REGISTRY}", 'docker-registry-credentials') {
                                    image.push()
                                    image.push('latest')
                                }
                            }
                        }
                    }
                }
            }
        }
        
        stage('Deploy to Development') {
            when {
                branch 'develop'
            }
            steps {
                script {
                    // Deploy to development environment
                    sh """
                        kubectl set image deployment/admin-tool admin-tool=${DOCKER_REGISTRY}/${DOCKER_REPO}/admin-tool:${BUILD_VERSION} -n development
                        kubectl set image deployment/auth-service auth-service=${DOCKER_REGISTRY}/${DOCKER_REPO}/auth-service:${BUILD_VERSION} -n development
                        kubectl set image deployment/chat-service chat-service=${DOCKER_REGISTRY}/${DOCKER_REPO}/chat-service:${BUILD_VERSION} -n development
                        kubectl set image deployment/chatbot-service chatbot-service=${DOCKER_REGISTRY}/${DOCKER_REPO}/chatbot-service:${BUILD_VERSION} -n development
                        kubectl set image deployment/ekyc-service ekyc-service=${DOCKER_REGISTRY}/${DOCKER_REPO}/ekyc-service:${BUILD_VERSION} -n development
                        kubectl set image deployment/email-service email-service=${DOCKER_REGISTRY}/${DOCKER_REPO}/email-service:${BUILD_VERSION} -n development
                        kubectl set image deployment/firebase-service firebase-service=${DOCKER_REGISTRY}/${DOCKER_REPO}/firebase-service:${BUILD_VERSION} -n development
                        kubectl set image deployment/transaction-service transaction-service=${DOCKER_REGISTRY}/${DOCKER_REPO}/transaction-service:${BUILD_VERSION} -n development
                        kubectl set image deployment/user-service user-service=${DOCKER_REGISTRY}/${DOCKER_REPO}/user-service:${BUILD_VERSION} -n development
                        kubectl set image deployment/socket-service socket-service=${DOCKER_REGISTRY}/${DOCKER_REPO}/socket-service:${BUILD_VERSION} -n development
                    """
                }
            }
        }
        
        stage('Deploy to Production') {
            when {
                branch 'main'
            }
            steps {
                input message: 'Deploy to Production?', ok: 'Deploy'
                script {
                    // Deploy to production environment
                    sh """
                        kubectl set image deployment/admin-tool admin-tool=${DOCKER_REGISTRY}/${DOCKER_REPO}/admin-tool:${BUILD_VERSION} -n production
                        kubectl set image deployment/auth-service auth-service=${DOCKER_REGISTRY}/${DOCKER_REPO}/auth-service:${BUILD_VERSION} -n production
                        kubectl set image deployment/chat-service chat-service=${DOCKER_REGISTRY}/${DOCKER_REPO}/chat-service:${BUILD_VERSION} -n production
                        kubectl set image deployment/chatbot-service chatbot-service=${DOCKER_REGISTRY}/${DOCKER_REPO}/chatbot-service:${BUILD_VERSION} -n production
                        kubectl set image deployment/ekyc-service ekyc-service=${DOCKER_REGISTRY}/${DOCKER_REPO}/ekyc-service:${BUILD_VERSION} -n production
                        kubectl set image deployment/email-service email-service=${DOCKER_REGISTRY}/${DOCKER_REPO}/email-service:${BUILD_VERSION} -n production
                        kubectl set image deployment/firebase-service firebase-service=${DOCKER_REGISTRY}/${DOCKER_REPO}/firebase-service:${BUILD_VERSION} -n production
                        kubectl set image deployment/transaction-service transaction-service=${DOCKER_REGISTRY}/${DOCKER_REPO}/transaction-service:${BUILD_VERSION} -n production
                        kubectl set image deployment/user-service user-service=${DOCKER_REGISTRY}/${DOCKER_REPO}/user-service:${BUILD_VERSION} -n production
                        kubectl set image deployment/socket-service socket-service=${DOCKER_REGISTRY}/${DOCKER_REPO}/socket-service:${BUILD_VERSION} -n production
                    """
                }
            }
        }
    }
    
    post {
        always {
            cleanWs()
        }
        success {
            echo 'Pipeline succeeded!'
            // Send success notification
        }
        failure {
            echo 'Pipeline failed!'
            // Send failure notification
        }
    }
}