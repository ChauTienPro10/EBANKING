pipeline {
    agent any
    
    environment {
        MAVEN_OPTS = '-Xmx1024m'
        JAVA_HOME = '/usr/lib/jvm/java-17-openjdk'
    }
    
    tools {
        maven 'Maven-3.9.0'
        jdk 'JDK-17'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.BUILD_VERSION = sh(
                        script: "echo '1.0.${BUILD_NUMBER}'",
                        returnStdout: true
                    ).trim()
                }
            }
        }
        
        stage('Build & Test') {
            parallel {
                stage('Admin Tool') {
                    steps {
                        dir('adminTool') {
                            script {
                                def buildScript = load 'build.groovy'
                                buildScript.buildModule()
                            }
                        }
                    }
                }
                
                stage('Auth Service') {
                    steps {
                        dir('authService') {
                            script {
                                def buildScript = load 'build.groovy'
                                buildScript.buildModule()
                            }
                        }
                    }
                }
                
                stage('Chat Service') {
                    steps {
                        dir('chatService') {
                            script {
                                def buildScript = load 'build.groovy'
                                buildScript.buildModule()
                            }
                        }
                    }
                }
                
                stage('Chatbot Service') {
                    steps {
                        dir('chatbotService') {
                            script {
                                def buildScript = load 'build.groovy'
                                buildScript.buildModule()
                            }
                        }
                    }
                }
                
                stage('eKYC Service') {
                    steps {
                        dir('ekycService') {
                            script {
                                def buildScript = load 'build.groovy'
                                buildScript.buildModule()
                            }
                        }
                    }
                }
                
                stage('Email Service') {
                    steps {
                        dir('emailService') {
                            script {
                                def buildScript = load 'build.groovy'
                                buildScript.buildModule()
                            }
                        }
                    }
                }
                
                stage('Firebase Service') {
                    steps {
                        dir('firebaseService') {
                            script {
                                def buildScript = load 'build.groovy'
                                buildScript.buildModule()
                            }
                        }
                    }
                }
                
                stage('Transaction Service') {
                    steps {
                        dir('transactionService') {
                            script {
                                def buildScript = load 'build.groovy'
                                buildScript.buildModule()
                            }
                        }
                    }
                }
                
                stage('User Service') {
                    steps {
                        dir('userService') {
                            script {
                                def buildScript = load 'build.groovy'
                                buildScript.buildModule()
                            }
                        }
                    }
                }
                
                stage('Socket Service') {
                    steps {
                        dir('socket') {
                            script {
                                def buildScript = load 'build.groovy'
                                buildScript.buildModule()
                            }
                        }
                    }
                }
            }
        }
        
        stage('Package') {
            parallel {
                stage('Package Admin Tool') {
                    steps {
                        dir('adminTool') {
                            sh 'mvn package -DskipTests'
                            archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                        }
                    }
                }
                
                stage('Package Auth Service') {
                    steps {
                        dir('authService') {
                            sh 'mvn package -DskipTests'
                            archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                        }
                    }
                }
                
                stage('Package Chat Service') {
                    steps {
                        dir('chatService') {
                            sh 'mvn package -DskipTests'
                            archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                        }
                    }
                }
                
                stage('Package Chatbot Service') {
                    steps {
                        dir('chatbotService') {
                            sh 'mvn package -DskipTests'
                            archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                        }
                    }
                }
                
                stage('Package eKYC Service') {
                    steps {
                        dir('ekycService') {
                            sh 'mvn package -DskipTests'
                            archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                        }
                    }
                }
                
                stage('Package Email Service') {
                    steps {
                        dir('emailService') {
                            sh 'mvn package -DskipTests'
                            archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                        }
                    }
                }
                
                stage('Package Firebase Service') {
                    steps {
                        dir('firebaseService') {
                            sh 'mvn package -DskipTests'
                            archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                        }
                    }
                }
                
                stage('Package Transaction Service') {
                    steps {
                        dir('transactionService') {
                            sh 'mvn package -DskipTests'
                            archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                        }
                    }
                }
                
                stage('Package User Service') {
                    steps {
                        dir('userService') {
                            sh 'mvn package -DskipTests'
                            archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                        }
                    }
                }
                
                stage('Package Socket Service') {
                    steps {
                        dir('socket') {
                            sh 'mvn package -DskipTests'
                            archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                        }
                    }
                }
            }
        }
    }
    
    post {
        success {
            echo 'Pipeline succeeded!'
            echo 'JAR files are available at: /var/jenkins_home/workspace/EBANKING/output_jar_file/'
            // Send success notification
        }
        failure {
            echo 'Pipeline failed!'
            // Send failure notification
        }
    }
}